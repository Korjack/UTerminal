<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:UTerminal.Views.Components"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d">
    
    <Design.PreviewWith>
        <Border Padding="20">
            <StackPanel Spacing="10" Margin="20" Width="400">
                <local:TitledBorderPanel Title="Preview Title" 
                                         BorderBrush="Blue"
                                         BorderThickness="2">
                    <TextBlock Text="This is sample content"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="20"/>
                </local:TitledBorderPanel>
            </StackPanel>
        </Border>
    </Design.PreviewWith>
    
    <Style Selector="local|TitledBorderPanel">
        <Setter Property="ClipToBounds" Value="False"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Panel IsEnabled="{TemplateBinding IsEnabled}">
                    <Border BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"/>
                    </Border>
                    
                    <TextBlock Text="{TemplateBinding Title}"
                               FontSize="{TemplateBinding TitleFontSize}"
                               Background="{TemplateBinding TitleBackground}"
                               Foreground="{TemplateBinding TitleForeground}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               Margin="0. -10, 0, 0"
                               Padding="5"/>
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    
</Styles>